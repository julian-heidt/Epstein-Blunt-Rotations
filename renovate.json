{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly", "group:allNonMajor"],
  "packageRules": [
    {
      "description": "A mongo major bump needs a data migration plan",
      "matchPackageNames": ["mongo"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "A @vitejs/plugin-react major needs the matching vite major",
      "matchPackageNames": ["vite", "@vitejs/plugin-react"],
      "matchUpdateTypes": ["major"],
      "groupName": "vite major"
    }
  ]
}
